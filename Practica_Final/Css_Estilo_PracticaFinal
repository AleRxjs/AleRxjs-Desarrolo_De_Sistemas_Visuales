*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
  text-align:center;
  color:white;
  font-weight:bold;
  border:1px solid #ffffff44;
}

.container{
  width:100vw;
  height:100vh;
  display:flex;
  flex-direction:column;
}

.header{
  height:10%;
  display:flex;
}

.header .h-left{
  width:20%;
  background:#5d87b3;
}

.header .h-right{
  width:80%;
  background:#2c5282;
}

.nav{
  height:10%;
  display:flex;
}

.nav div{
  width:25%;
  background:#3db8a5;
}

.main{
  height:60%;
  display:flex;
}


.aside{
  width:25%;
  background:#6ab26a;
}

.content{
  width:75%;
  display:flex;
  flex-direction:column;
}

.content-top{
  height:40%;
  background:#e4a85a;
}

.content-bottom{
  height:60%;
  display:flex;
}

.content-bottom div{
  width:50%;
  background:#5788bd;
}

/* FOOTER */
.footer{
  height:20%;
  display:flex;
}

.footer div{
  background:#9ca4b2;
}

.footer div:nth-child(1){ width:50%; }
.footer div:nth-child(2){ width:25%; }
.footer div:nth-child(3){ width:25%; }
